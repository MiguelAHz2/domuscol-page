# ------------------------------------------------------------------
# DomusCol landing: variables de entorno
# Copia este archivo como .env.local para desarrollo local. En Vercel,
# agrégalas en Project Settings > Environment Variables.
# Las que empiezan por NEXT_PUBLIC_ terminan en el navegador: nunca
# pongas secretos en ellas. Todo lo opcional puede quedar vacío.
# ------------------------------------------------------------------

# Sitio público -----------------------------------------------------
# URL canónica: la usan el sitemap, la imagen para compartir y el SEO.
NEXT_PUBLIC_SITE_URL=https://domuscol.me
# Login del producto para residentes (botón "Acceso residentes").
# Déjala vacía mientras el portal no exista: el botón explica que llega
# con la Fase 1 y ofrece WhatsApp.
NEXT_PUBLIC_RESIDENTS_URL=
# Video demostrativo del botón del inicio: enlace de YouTube, Vimeo o un
# .mp4. Vacío, el botón dice "Ver el recorrido" y reproduce "Un día en
# Altos del Bosque" desde las 6 a. m.
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Contacto que se muestra en el sitio -------------------------------
# WhatsApp: solo dígitos, con el indicativo 57.
NEXT_PUBLIC_WHATSAPP_NUMBER=573239377429
# Cómo se muestra el número en el footer.
NEXT_PUBLIC_WHATSAPP_LABEL=+57 323 937 7429
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@domuscol.me
NEXT_PUBLIC_SALES_EMAIL=ventas@domuscol.me

# Redes sociales (opcional). Un valor vacío oculta el ícono.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Responsable del tratamiento de datos (Ley 1581 de 2012) -----------
# Aparece en las páginas legales. Complétalo antes de publicar.
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_NIT=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_CITY=
# Correo para consultas y reclamos sobre datos personales. Si queda
# vacío se usa el de soporte.
NEXT_PUBLIC_PRIVACY_EMAIL=

# Entrega del formulario de demo (solo servidor) --------------------
# Configura al menos un canal. Si no hay ninguno, en producción el
# formulario responde con error y remite a WhatsApp.

# 1) Correo con Resend (https://resend.com)
RESEND_API_KEY=
# Dónde llegan las solicitudes. Varias direcciones separadas por coma.
LEADS_EMAIL_TO=ventas@domuscol.me
# Remitente. El dominio debe estar verificado en Resend. Con
# "DomusCol <onboarding@resend.dev>" solo puedes enviarte correos a ti
# mismo (sirve para una primera prueba, no para confirmar a clientes).
LEADS_EMAIL_FROM=DomusCol <solicitudes@domuscol.me>
# Correo de confirmación al interesado (usa la misma cuenta de Resend).
# Pon "false" para desactivarlo.
LEADS_CONFIRMATION_EMAIL=true

# 2) Webhook (Google Sheets con Apps Script, Make, Zapier, un CRM...)
# Recibe un POST en JSON por cada solicitud.
LEADS_WEBHOOK_URL=
# Opcional. Se envía como "Authorization: Bearer <valor>".
LEADS_WEBHOOK_SECRET=

# 3) Aviso a tu WhatsApp con CallMeBot (https://www.callmebot.com)
# Gratis y solo para tu propio número. Activa tu API key siguiendo
# https://www.callmebot.com/blog/free-api-whatsapp-messages/ (agregas el
# número del bot y le envías el mensaje de activación desde tu WhatsApp).
CALLMEBOT_PHONE=+573239377429
CALLMEBOT_APIKEY=

# Anti-bots con Cloudflare Turnstile (opcional) ---------------------
# https://dash.cloudflare.com > Turnstile > Add widget (dominio
# domuscol.me, modo "Managed"). Sin estas dos variables no se verifica.
# Para pruebas locales Cloudflare publica claves que siempre aprueban:
# sitio 1x00000000000000000000AA y secreto 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Monitoreo de errores con Sentry (opcional) ------------------------
# DSN del proyecto: https://sentry.io > Settings > Projects > Client Keys.
# El mismo valor en las dos; vacías, Sentry no se carga.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Solo para subir source maps en el build (errores legibles). Crea el
# token en Settings > Auth Tokens. Sin token el build no usa Sentry.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Prueba del formulario con testmail.app (solo en tu equipo) --------
# La usa scripts/probar-formulario.mjs; no la subas a Vercel.
TESTMAIL_APIKEY=
TESTMAIL_NAMESPACE=
